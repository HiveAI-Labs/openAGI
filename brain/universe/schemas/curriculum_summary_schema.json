{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CurriculumSummary",
  "type": "object",
  "required": ["generated_at", "artifacts_dir", "suites"],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "artifacts_dir": {"type": "string"},
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suite", "runs_total"],
        "properties": {
          "suite": {"type": "string"},
          "runs_total": {"type": "integer"},
          "success_rate_latest": {"type": ["number", "null"]},
          "success_rate_average": {"type": ["number", "null"]},
          "latest_timestamp": {"type": ["string", "null"]},
          "determinism_token": {"type": ["string", "null"]},
          "age_hours": {"type": ["number", "null"]},
          "stale": {"type": "boolean"}
        }
      }
    },
    "determinism_token": {"type": ["string", "null"]},
    "stale_window_hours": {"type": ["number", "null"]}
  }
}
